  "views": {
    "radcore.v_schema_audit_columns": {
      "name": "v_schema_audit_columns",
      "schema": "radcore",
      "columns": {
        "tableName": {
          "name": "tableName",
          "type": "text",
          "primaryKey": false,
          "notNull": false
        },
        "columnName": {
          "name": "columnName",
          "type": "text",
          "primaryKey": false,
          "notNull": false
        },
        "problem": {
          "name": "problem",
          "type": "text",
          "primaryKey": false,
          "notNull": false
        }
      },
      "definition": "with audited as (\n    select c.oid, c.relname,\n      string_to_array(split_part(encode(g.tgargs, 'escape'), '\\000',1), ',') as keys,\n      string_to_array(nullif(split_part(encode(g.tgargs, 'escape'), '\\000',2), ''), ',') as keep,\n      string_to_array(nullif(split_part(encode(g.tgargs, 'escape'), '\\000',3), ''), ',') as redact\n    from pg_catalog.pg_trigger g\n    join pg_catalog.pg_class c on c.oid = g.tgrelid\n    join pg_catalog.pg_namespace n on n.oid = c.relnamespace\n    where g.tgname = 'audit_row' and not g.tgisinternal and n.nspname = 'radcore'\n  ), columns as (\n    select t.relname, a.attname,\n      a.attname = any (coalesce(t.keep, '{}')) as kept, a.attname = any (coalesce(t.redact, '{}')) as redacted,\n      a.attname ~ '(hash|secret|token|ciphertext|password)' and a.atttypid not in ('timestamptz'::regtype,\n        'timestamp'::regtype, 'date'::regtype, 'bool'::regtype, 'int4'::regtype, 'int8'::regtype, 'numeric'::regtype) as secret_like,\n      a.attname = any (t.keys || array['created_at', 'created_by', 'updated_at', 'updated_by']) as exempt\n    from audited t\n    join pg_catalog.pg_attribute a on a.attrelid = t.oid and a.attnum > 0 and not a.attisdropped\n  )\n  select relname::text as table_name, attname::text as column_name, 'unlisted' as problem from columns\n    where not exempt and not kept and not redacted\n  union all\n  select relname::text, attname::text, 'kept and redacted' from columns where kept and redacted\n  union all\n  select relname::text, attname::text, 'a secret not redacted' from columns\n    where secret_like and not redacted",
      "materialized": false,
      "isExisting": false
    },
