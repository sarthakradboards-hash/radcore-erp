          "type": "text",
          "primaryKey": false,
          "notNull": false
        }
      },
      "definition": "select n.nspname::text as schema_name, t.typname::text as type_name\n  from pg_catalog.pg_type t\n  join pg_catalog.pg_namespace n on n.oid = t.typnamespace\n  where t.typtype = 'e'\n    and n.nspname not in ('pg_catalog', 'information_schema', 'pgboss', 'drizzle') and left(n.nspname, 3) <> 'pg_'",
      "name": "v_schema_enums",
      "schema": "radcore",
      "isExisting": false,
      "materialized": false
    },
    "radcore.v_schema_fk_without_index": {
